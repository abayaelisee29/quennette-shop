# Copiez ce fichier en .env.local (il n'est jamais envoyé sur GitHub) et remplissez les valeurs.
# En ligne (Vercel), mettez les mêmes noms dans Settings > Environment Variables.

# ---------- Supabase (base de données) ----------
# Sans ces deux lignes, le site enregistre tout dans data/db.json (mode local).
# Adresse du projet : Supabase > Project Settings > Data API (ou bouton « Connect »).
SUPABASE_URL=https://votre-projet.supabase.co
# Clé SECRÈTE : Supabase > Project Settings > API Keys > Secret keys (sb_secret_...).
# Ne jamais la partager ni la mettre dans le code.
SUPABASE_SECRET_KEY=sb_secret_...

# ---------- Stripe (paiement) ----------
# Clés de TEST : Tableau de bord Stripe > Développeurs > Clés API, avec « Mode test » activé.
# Sans clé, le paiement fonctionne en mode démo (simulé).
STRIPE_SECRET_KEY=sk_test_...
# Optionnel : secret du webhook (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...
